# Copy to .env, replace the sample credentials, and never commit the populated file.
POSTGRES_DB=agencyos
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD
AGENCYOS_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Generate a hash with: node scripts/hash-password.js (paste password, then Ctrl+Z and Enter on Windows)
# Put the returned saltHex:keyHex below. Use single quotes around the JSON value.
AGENCYOS_USERS_JSON='[{"username":"admin","role":"admin","passwordHash":"PASTE_GENERATED_SALT_HEX_COLON_HASH_HEX"}]'
